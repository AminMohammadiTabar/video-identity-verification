# Copy values into your shell environment. Never commit actual credentials.

# Shared PostgreSQL instance, independently owned schemas per service.
POSTGRES_PASSWORD=replace-with-a-local-database-password
AUTH_DB_URL=jdbc:postgresql://localhost:5432/video_identity_db
AUTH_DB_USERNAME=vik_local
AUTH_DB_PASSWORD=
DMS_DB_URL=jdbc:postgresql://localhost:5432/video_identity_db
DMS_DB_USERNAME=vik_local
DMS_DB_PASSWORD=
WORKFLOW_DB_URL=jdbc:postgresql://localhost:5432/video_identity_db
WORKFLOW_DB_USERNAME=vik_local
WORKFLOW_DB_PASSWORD=

# DMS administrator and narrowly scoped AUTH service identity.
DMS_API_USERNAME=dms-admin
DMS_API_PASSWORD=replace-with-a-long-unique-password
DMS_AUTH_SERVICE_USERNAME=auth-service
DMS_AUTH_SERVICE_PASSWORD=replace-with-a-different-long-service-password
DMS_STORAGE_ROOT=./storage/dms

# AUTH -> DMS backend-only credentials (must match DMS_AUTH_SERVICE_*).
AUTH_DMS_URL=http://127.0.0.1:8081
AUTH_DMS_USERNAME=auth-service
AUTH_DMS_PASSWORD=replace-with-the-same-service-password

# Optional one-time admin provisioning; disable after the first bootstrap.
AUTH_BOOTSTRAP_ADMIN_ENABLED=false
AUTH_BOOTSTRAP_ADMIN_EMAIL=
AUTH_BOOTSTRAP_ADMIN_PASSWORD=

# Durable email outbox is always written. SMTP delivery remains opt-in.
EMAIL_NOTIFICATIONS_ENABLED=false
EMAIL_FROM=no-reply@example.invalid
EMAIL_MAX_ATTEMPTS=8
EMAIL_POLL_INTERVAL_MS=15000
# SPRING_MAIL_HOST=smtp.example.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=
# SPRING_MAIL_PASSWORD=

# OpenTelemetry: context propagation stays enabled; OTLP export is opt-in.
OTEL_EXPORTER_OTLP_ENABLED=false
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces
TRACING_SAMPLING_PROBABILITY=1.0
# AUDIT_TRUSTED_PROXIES=127.0.0.1,10.0.0.10

# Swagger is enabled automatically in local/h2; disabled by default in production.
# SWAGGER_ENABLED=true
