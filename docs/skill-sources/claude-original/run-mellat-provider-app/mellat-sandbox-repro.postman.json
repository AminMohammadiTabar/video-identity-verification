    {
      "name": "11. Issue Card",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Same signing approach as request 8 (Open Account): the payload IS",
              "// the JWS claims set, verbatim, no exp/iat/jti added. requestId/timestamp",
              "// are freshly generated each run - Mellat uses requestId for duplicate",
              "// detection (section 5.11), so replaying a fixed value would get",
              "// rejected on a second run.",
              "function base64UrlFromArrayBuffer(buffer) {",
              "  const bytes = new Uint8Array(buffer);",
              "  let binary = '';",
              "  for (let i = 0; i < bytes.byteLength; i++) {",
              "    binary += String.fromCharCode(bytes[i]);",
              "  }",
              "  return btoa(binary).replace(/\\+/g, '-').replace(/\\//g, '_').replace(/=+$/, '');",
              "}",
              "",
              "function base64UrlFromString(str) {",
              "  return btoa(unescape(encodeURIComponent(str))).replace(/\\+/g, '-').replace(/\\//g, '_').replace(/=+$/, '');",
              "}",
              "",
              "function pemToArrayBuffer(pem) {",
              "  const b64 = pem",
              "    .replace('-----BEGIN PRIVATE KEY-----', '')",
              "    .replace('-----END PRIVATE KEY-----', '')",
              "    .replace(/\\s/g, '');",
              "  const binary = atob(b64);",
              "  const bytes = new Uint8Array(binary.length);",
              "  for (let i = 0; i < binary.length; i++) {",
              "    bytes[i] = binary.charCodeAt(i);",
              "  }",
              "  return bytes.buffer;",
              "}",
              "",
              "const privateKeyPem = pm.variables.get('private_key');",
              "const payload = JSON.parse(pm.variables.get('issue_card_sample_payload'));",
              "payload.requestId = 'postman-issue-' + Date.now();",
              "payload.timestamp = new Date().toISOString();",
              "",
              "const header = { alg: 'RS256', typ: 'JWT' };",
              "const headerB64 = base64UrlFromString(JSON.stringify(header));",
              "const payloadB64 = base64UrlFromString(JSON.stringify(payload));",
              "const signingInput = `${headerB64}.${payloadB64}`;",
              "",
              "const keyBuffer = pemToArrayBuffer(privateKeyPem);",
              "const cryptoKey = await crypto.subtle.importKey(",
              "  'pkcs8',",
              "  keyBuffer,",
              "  { name: 'RSASSA-PKCS1-v1_5', hash: 'SHA-256' },",
              "  false,",
              "  ['sign']",
              ");",
              "",
              "const signatureBuffer = await crypto.subtle.sign(",
              "  'RSASSA-PKCS1-v1_5',",
              "  cryptoKey,",
              "  new TextEncoder().encode(signingInput)",
              ");",
              "",
              "const signedMessage = `${signingInput}.${base64UrlFromArrayBuffer(signatureBuffer)}`;",
              "pm.collectionVariables.set('issue_card_message', signedMessage);",
              "pm.collectionVariables.set('track_card_request_id', payload.requestId);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Issue Card returned 200', function () {",
              "  pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"message\": \"{{issue_card_message}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/digital-platform/api/baas/card-requests/issue-cards/new",
          "host": ["{{base_url}}"],
          "path": ["digital-platform", "api", "baas", "card-requests", "issue-cards", "new"]
        },
        "description": "Section 5.11. issue_card_sample_payload (editable JSON collection variable) is signed into a compact JWS by this request's pre-request script, with a fresh requestId/timestamp each run."
      },
      "response": []
