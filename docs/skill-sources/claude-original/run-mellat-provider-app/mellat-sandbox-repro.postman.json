          "raw": "{\n  \"message\": \"{{reissue_card_message}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/digital-platform/api/baas/card-requests/issue-cards/replace",
          "host": ["{{base_url}}"],
          "path": ["digital-platform", "api", "baas", "card-requests", "issue-cards", "replace"]
        },
        "description": "Section 5.12. reissue_card_sample_payload (editable JSON collection variable) is signed into a compact JWS by this request's pre-request script, with a fresh requestId/timestamp each run."
      },
      "response": []
    },
    {
      "name": "13. Track Card Issuance",
      "request": {
        "method": "GET",
        "header": [],
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }]
