{
  "info": {
    "_postman_id": "b6f4a1e0-4c2a-4a8e-9b0a-3a1f2e5c9d10",
    "name": "Bank Mellat BaaS Sandbox (direct)",
    "description": "Calls Bank Mellat's real \"digital-platform\" BaaS sandbox directly - NOT this service's own API (see the separate `mellat-provider-service` Postman collection under `postman/` for that). Useful for reproducing/isolating a bank-side issue without mellat-provider-service in the loop at all, and for confirming whether a problem is on Mellat's side before reporting it to their team.\n\nFlow: sign a client-assertion JWT (RFC 7523 private_key_jwt) in the Login request's pre-request script, log in to get a real Mellat-issued access token, then use that token against every base-data/account/card endpoint below.\n\nPostman's sandbox is a different engine from Insomnia's (postman-sandbox, not a plain Electron hidden window). The pre-request scripts below use the standard Web Crypto API (crypto.subtle). If your Postman version's sandbox lacks crypto.subtle/await support, don't fight it - run generate-client-assertion.sh (in this repo, same folder as this file) and paste its output directly into the client_assertion variable by hand before sending Login. That always works regardless of sandbox capabilities.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Login (auth/login)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "function base64UrlFromArrayBuffer(buffer) {",
              "  const bytes = new Uint8Array(buffer);",
              "  let binary = '';",
              "  for (let i = 0; i < bytes.byteLength; i++) {",
              "    binary += String.fromCharCode(bytes[i]);",
              "  }",
              "  return btoa(binary).replace(/\\+/g, '-').replace(/\\//g, '_').replace(/=+$/, '');",
              "}",
              "",
              "function base64UrlFromString(str) {",
              "  return btoa(unescape(encodeURIComponent(str))).replace(/\\+/g, '-').replace(/\\//g, '_').replace(/=+$/, '');",
              "}",
              "",
              "function pemToArrayBuffer(pem) {",
              "  const b64 = pem",
              "    .replace('-----BEGIN PRIVATE KEY-----', '')",
              "    .replace('-----END PRIVATE KEY-----', '')",
              "    .replace(/\\s/g, '');",
              "  const binary = atob(b64);",
              "  const bytes = new Uint8Array(binary.length);",
              "  for (let i = 0; i < binary.length; i++) {",
              "    bytes[i] = binary.charCodeAt(i);",
              "  }",
              "  return bytes.buffer;",
              "}",
              "",
              "function randomHex(byteLength) {",
              "  const bytes = new Uint8Array(byteLength);",
              "  crypto.getRandomValues(bytes);",
              "  return Array.from(bytes).map(b => b.toString(16).padStart(2, '0')).join('');",
              "}",
              "",
              "const clientId = pm.variables.get('client_id');",
              "const audience = pm.variables.get('audience');",
              "const privateKeyPem = pm.variables.get('private_key');",
              "",
              "if (!privateKeyPem) {",
              "  throw new Error('private_key collection variable is empty/undefined - check the collection\\'s Variables tab (not a Postman Environment) has a CURRENT value set, not just an INITIAL value.');",
              "}",
              "",
              "const now = Math.floor(Date.now() / 1000);",
              "const header = { alg: 'RS256', typ: 'JWT' };",
              "const payload = {",
              "  sub: clientId,",
              "  iss: clientId,",
              "  aud: audience,",
              "  iat: now,",
              "  exp: now + 300,",
              "  jti: randomHex(16),",
              "};",
              "",
              "const headerB64 = base64UrlFromString(JSON.stringify(header));",
              "const payloadB64 = base64UrlFromString(JSON.stringify(payload));",
              "const signingInput = `${headerB64}.${payloadB64}`;",
              "",
              "const keyBuffer = pemToArrayBuffer(privateKeyPem);",
              "const cryptoKey = await crypto.subtle.importKey(",
              "  'pkcs8',",
              "  keyBuffer,",
              "  { name: 'RSASSA-PKCS1-v1_5', hash: 'SHA-256' },",
              "  false,",
              "  ['sign']",
              ");",
              "",
              "const signatureBuffer = await crypto.subtle.sign(",
              "  'RSASSA-PKCS1-v1_5',",
              "  cryptoKey,",
              "  new TextEncoder().encode(signingInput)",
              ");",
              "",
              "const clientAssertion = `${signingInput}.${base64UrlFromArrayBuffer(signatureBuffer)}`;",
              "pm.collectionVariables.set('client_assertion', clientAssertion);",
              "",
              "// If the lines above throw (sandbox has no crypto.subtle/await), comment this",
              "// whole script out, run generate-client-assertion.sh yourself, and paste its",
              "// output straight into the client_assertion collection variable instead",
              "// (collection's ... menu -> Edit -> Variables tab -> CURRENT VALUE column)."
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "try {",
              "  const body = pm.response.json();",
              "  if (body && body.access_token) {",
              "    pm.collectionVariables.set('access_token', body.access_token);",
              "  }",
              "} catch (e) {",
              "  // Login failed (e.g. INVALID_AUDIENCE, or non-JSON body) - nothing to extract.",
              "}",
              "",
              "pm.test('Login returned 200', function () {",
              "  pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{client_assertion}}", "type": "string" }]
        },
        "url": {
          "raw": "{{base_url}}/auth/login",
          "host": ["{{base_url}}"],
          "path": ["auth", "login"]
        },
        "description": "RFC 7523 private_key_jwt: the client_assertion signed in this request's pre-request script is sent as the Bearer token here. Returns a Mellat-issued access_token, captured into the access_token collection variable for every request below."
      },
      "response": []
    },
